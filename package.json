{
  "name": "sapphire-windows",
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/desktop.mjs",
  "description": "A community Windows desktop notch for music, notes, focus, and system controls.",
  "author": "Sapphire Community",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "electron . --smoke-test",
    "test:desktop:isolated": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop.ps1",
    "package": "npm run build:native && npm run build && node scripts/package.mjs nsis",
    "package:msix": "npm run build:native && npm run build && node scripts/package.mjs appx",
    "preview": "vite preview",
    "package:release": "npm run build:native && npm run build && node scripts/package.mjs release",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "tech.sapphire.windows",
    "productName": "Sapphire",
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md",
      "docs/PARITY.md",
      "scripts/renderer-smoke.mjs",
      "scripts/lifecycle-smoke.mjs",
      "scripts/reliability-smoke.mjs",
      "scripts/motion-smoke.mjs",
      "scripts/window-order.ps1",
      "scripts/soak.mjs"
    ],
    "extraResources": [
      {
        "from": "native/publish/win-x64",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/sapphire.ico",
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Sapphire-${version}-win-${arch}-Setup.${ext}"
    },
    "appx": {
      "identityName": "tech.sapphire.windows",
      "publisher": "CN=Sapphire Development",
      "publisherDisplayName": "Sapphire Community",
      "displayName": "Sapphire",
      "backgroundColor": "#000000",
      "applicationId": "Sapphire",
      "customManifestPath": "packaging/AppxManifest.xml"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "artifactName": "Sapphire-${version}-win-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "electron": "42.11.16",
    "electron-builder": "26.18.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmed-progra/sapphire-windows.git"
  },
  "homepage": "https://github.com/ahmed-progra/sapphire-windows#readme",
  "bugs": {
    "url": "https://github.com/ahmed-progra/sapphire-windows/issues"
  }
}
